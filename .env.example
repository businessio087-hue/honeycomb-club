NODE_ENV=production
# The hosting platform usually sets PORT automatically.
PORT=3000

# MySQL connection string. Keep this value private.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# OAuth and session configuration.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=

# Optional server-side integrations. Never expose MANUS_API_KEY in browser code.
MANUS_API_URL=
MANUS_API_KEY=
OWNER_OPEN_ID=

# This key is intentionally exposed to the browser by the public config endpoint.
MANUS_API_BROWSER_KEY=
